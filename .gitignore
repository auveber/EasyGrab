# ВАЖНО: git понимает # только в НАЧАЛЕ строки. Комментарий в конце строки
# становится частью имени файла, и правило перестаёт работать — поэтому
# все пояснения здесь стоят отдельными строками.

# --- СЕКРЕТЫ. Никогда не коммитить ------------------------------------------
# git хранит историю навсегда: если такой файл попал в коммит хотя бы раз,
# удаление его из рабочей папки уже не поможет — ключ останется в истории.

# API-ключ YouTube открытым текстом
session.json
# сессия Instagram — равнозначна паролю
ig_settings_*.json
ig_session_*

# --- ЛИЧНЫЕ ДАННЫЕ ----------------------------------------------------------
# Это рабочая информация, а не код. В репозитории ей не место даже в приватном:
# приватный репозиторий можно случайно открыть, а историю не отмотать.

# ссылки на все рабочие аккаунты
accounts.json
# накопленные замеры метрик
history.json
# ID собираемых каналов
yt_channel_cache.json
# выгрузка технического журнала
easygrab_diagnostics.txt

# --- СЛУЖЕБНОЕ --------------------------------------------------------------
# номер сборки, меняется от каждой правки кода
build.json
# окружение Python: 95 МБ, у каждого своё, ставится по requirements.txt
venv/
__pycache__/
*.py[cod]
.DS_Store

# --- ВЫГРУЗКИ ---------------------------------------------------------------
easygrab_export.xlsx
easygrab_export.csv
easygrab_export.txt
easygrab_export.pdf
